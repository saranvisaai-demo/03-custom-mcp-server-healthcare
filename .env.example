# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — this .env.example just documents what's expected.
#
# Optional. Only needed when running on a VPS / reachable from outside
# localhost. Leave unset (or delete .env) for local development — the
# server falls back to a localhost-only default.
#
# Comma-separated list of Host headers the server will accept, matching
# how clients actually connect to it (":*" matches any port).
# ALLOWED_HOSTS=<public-ip-or-domain>:8000,127.0.0.1:*,localhost:*
